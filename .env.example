NODE_ENV=development
HOST=0.0.0.0
PORT=3000
TEMP_ROOT=./tmp
MAX_UPLOAD_MB=100
MAX_PDF_PAGES=500
MAX_CONCURRENT_JOBS=1
MAX_QUEUE_SIZE=10
REQUEST_TIMEOUT_MS=1800000
LOG_LEVEL=info
NODE_OPTIONS=--max-old-space-size=1536

# Chỉ dùng khi chạy VPS với compose.vps.yml
APP_PORT=3000
TEMP_STORAGE_SIZE=2g
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_CPU_LIMIT=2.0
DOMAIN=pdf.example.com
ACME_EMAIL=admin@example.com

# Theo dõi RAM và tiến độ trong log
MEMORY_LOG_INTERVAL_MS=15000
MEMORY_WARNING_PERCENT=85
PROGRESS_LOG_EVERY_PAGES=10

# Máy chủ RAM thấp: phần nén chạy trong worker riêng và tự dừng an toàn trước khi quá tải.
# Render Free nên dùng MAX_UPLOAD_MB=35, MAX_PDF_PAGES=120, MAX_CONCURRENT_JOBS=1.

# Tác vụ nền: kết quả được giữ để tải lại, tránh giữ request HTTP quá lâu
JOB_RETENTION_MS=1800000
JOB_CLEANUP_INTERVAL_MS=60000
MAX_STORED_JOBS=10
