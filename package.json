{
  "name": "web-tool-pdf",
  "version": "4.0.0",
  "private": true,
  "description": "Bộ công cụ PDF triển khai bằng Node.js, Fastify, MuPDF.js, Docker và VPS",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
