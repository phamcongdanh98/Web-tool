    "test": "node --test"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.6.0",
    "mupdf": "^1.28.0",
    "pdf-lib": "^1.17.1"
  }
}
